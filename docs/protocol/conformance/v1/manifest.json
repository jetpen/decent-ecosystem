      "expected": "accept",
      "reason": "Assertion may be valid longer than consent only if output token expires at consent ceiling."
    },
    {
      "id": "namespaced-nonauthorizing-extension",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050,
        "extensions": {
          "example.test:display": "Friendly label"
        }
      },
      "expected": "accept",
      "reason": "V1 ignores namespaced extension values for authority and preserves authorization claims."
    },
    {
      "id": "extension-cannot-widen-scope",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050,
        "extensions": {
          "example.test:extra-action": "delete"
        }
      },
      "expected": "accept",
      "reason": "Namespaced extension data is ignored by v1 and must not widen the core action set.",
      "output_invariant": {
        "storage_actions_must_equal": [
          "read",
          "update"
        ],
        "extension_values_authorize_nothing": true
      }
    },
