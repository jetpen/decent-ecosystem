  "semantic_vectors": [
    {
      "id": "positive-existing-object",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050
      },
      "expected": "accept",
      "reason": "Well-formed signed envelope with explicit existing-object consent scope."
    },
    {
      "id": "exact-subject-case-change",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:Alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050
      },
      "expected": "reject-at-adapter",
      "reason": "Identifier comparison is exact and case is not normalized; local subject must match linked identity.",
      "adapter_context": {
        "linked_local_subject": "mailto:alice@example.org"
      }
    },
    {
      "id": "different-storage-resource",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/beta",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050
      },
      "expected": "reject-at-adapter",
      "reason": "Grant audience must equal the single configured Storage resource.",
      "adapter_context": {
        "allowlisted_storage_audiences": [
          "https://storage.example.test/instance/alpha"
        ]
      }
    },
    {
      "id": "different-existing-object-digest",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "actions": [
          "read",
          "update"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050
      },
      "expected": "resource-policy-deny",
      "reason": "The token may encode the separately consented digest, but it must not authorize a request for another digest.",
      "use_context": {
        "requested_object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "requested_action": "read",
        "requested_purpose": "profile-update"
      }
    },
    {
      "id": "reduced-action-subset",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
        "storage_aud": "https://storage.example.test/instance/alpha",
        "object_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "actions": [
          "read"
        ],
        "purpose": "profile-update",
        "grant_jti": "grant-01JTEST000000000000000000",
        "consent_exp": 1900000050
      },
      "expected": "accept",
      "reason": "A grant may authorize a smaller explicit action set; adapter must not widen beyond it."
    },
    {
      "id": "explicit-delete-scope",
      "grant": {
        "wire_version": 1,
        "owner_identifier": "mailto:alice@example.org",
        "owner_public_key": "1111111111111111111111111111111111111111111111111111111111111111",
