{
  "wire_version": 1,
  "profile_id": "decent-storage-grant-semantics-v1",
  "adapter_profile": "decent-storage-grant-keycloak-26.8.0-v1",
  "canonicalization": "RFC 8785 JSON Canonicalization Scheme over semantic JSON values, UTF-8 bytes",
  "signed_transport": "RFC 7515 JWS Compact Serialization over exact protected-header and payload segments; RFC 7523 JWT Authorization Grant adapter-specific envelope",
  "supported_wire_versions": [
    1
  ],
  "rules": [
    "RFC 7523 input assertion aud targets AS; storage_aud identifies Storage resource.",
    "grant_jti equals signed assertion JWT jti for Keycloak 26.8.0 adapter.",
    "wallet grant signature is the single EdDSA JWS signature over the RFC 7515 JWS signing input; no separate detached signature.",
    "assertion exp and output access-token exp do not exceed consent_exp.",
    "one-use jti; uncertain token exchange requires fresh wallet authorization.",
    "actions and purpose are exact opaque strings; no universal vocabulary or URI normalization.",
    "extensions are namespaced and non-authorizing."
  ],
  "valid": [
    {
      "file": "fixtures/valid-grant.json",
      "expected": "accept"
    },
    {
      "file": "fixtures/valid-grant-noncanonical.json",
